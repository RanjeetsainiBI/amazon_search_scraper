{
  "name": "amazon-search-scraper",
  "version": "0.1.0",
  "description": "amazon.in search results to a seller lead list, with a web interface you run on your own laptop.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "scrape": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:mock-server": "node test/mock-server.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "npm install && npx playwright install chromium"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
