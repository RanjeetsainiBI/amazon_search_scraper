{
  "manifest_version": 3,
  "name": "AdLytics Xray - Seller Research for Amazon.in",
  "short_name": "AdLytics Xray",
  "version": "1.1.0",
  "description": "Scan amazon.in search pages, storefronts and products: organic & sponsored rank, Buy Box, BSR, manufacturer, seller details. CSV.",
  "homepage_url": "https://github.com/RanjeetsainiBI/amazon_search_scraper",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AdLytics Xray",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.amazon.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*"
      ],
      "js": [
        "parse.js",
        "scan.js",
        "panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
